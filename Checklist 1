                            { id: '4-6', badge: 'ROT', text: '<strong>“ROT” / Handzeichen “T” = Handlungen stoppen. Organizer übernimmt!</strong>' },
                            { id: '4-7', text: 'Anweisungen des Organizers folgen, Diskussionen danach' },
                            { id: '4-8', text: 'keine Heldentaten, deeskalierend verhalten' }
                        ]
                    }
                ]
            },
            {
                id: 'sec-5',
                number: '5',
                title: 'Gruppenaufnahme und Debriefing',
                groups: [
                    {
                        title: 'Gruppenaufnahme:',
                        items: [
                            { id: '5-1', text: 'alle Teilnehmer stehen in 2 (oder mehr) Reihen, ohne Masken (außer Kinder)' },
                            { id: '5-2', text: 'Motive der Schilder sollten gut sichtbar sein' },
                            { id: '5-3', text: 'das “Leb vegan!/Wir brauchen dich!” Schild ist <em>immer</em> in der Mitte' },
                            { id: '5-4', text: '“DER Tierrechtspodcast/Folge uns” Schild kommt nicht mit rauf' },
                            { id: '5-5', text: 'sauber ausgerichtet: symmetrisch, Schilder in einer Reihe immer auf einer Höhe, in die selbe Richtung zeigend (schwarze Seite/Fotoseite)' },
                            { id: '5-6', text: 'kleine Schilder außen/vorn, nicht dazwischen' },
                            { id: '5-7', text: 'Video: von links nach rechts, von rechts nach links, jeweils andere Seite der Schilder zu sehen' },
                            { id: '5-8', text: 'Foto: 2 Fotos, jeweils andere Seite der Schilder zu sehen, kein Weitwinkel, nah dran' }
                        ]
                    },
                    {
                        title: 'Debriefing:',
                        items: [
                            { id: '5-9', text: 'DANKE an alle Teilnehmenden sagen' },
                            { id: '5-10', text: 'neue Leute persönlich verabschieden und ermutigen wiederzukommen' },
                            { id: '5-11', text: 'kurze Feedback-Runde: Was lief gut? Was können wir verbessern?' },
                            { id: '5-12', text: 'besondere Situationen oder Probleme an RLV! weitergeben' },
                            { id: '5-13', text: 'nächstes Event ankündigen' },
                            { id: '5-14', text: 'Teilnehmende bitten, das nächste mal 1 Freund mitzubringen' },
                            { id: '5-15', text: 'ggf. Flyer zum Verteilen ausgeben (zum Auslegen in Restaurants, etc.)' }
                        ]
                    }
                ]
            }
        ];

        // State Management
        const STORAGE_KEY = 'neon_briefing_optimiert_v1';
        let checkedState = {};
        let openSections = {};
        let currentFilter = 'all'; // 'all', 'open', or 'done'

        // Initialize state from localStorage
        function loadState() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    checkedState = JSON.parse(saved);
                }
            } catch (e) {
                checkedState = {};
            }
            // Open all sections by default
            checklistData.forEach(sec => {
                openSections[sec.id] = true;
            });
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedState));
            } catch (e) {
                // Ignore storage errors in restricted environments
            }
        }

        // Render the entire checklist UI
        function renderChecklist() {
            const container = document.getElementById('checklist-container');
            container.innerHTML = '';

            let totalItems = 0;
            let totalChecked = 0;

            checklistData.forEach(section => {
                // Count section progress
                let secTotal = 0;
                let secChecked = 0;
                section.groups.forEach(g => {
                    g.items.forEach(item => {
                        secTotal++;
                        totalItems++;
                        if (checkedState[item.id]) {
                            secChecked++;
                            totalChecked++;
                        }
                    });
                });

                const isSectionComplete = secTotal > 0 && secTotal === secChecked;
                const isOpen = openSections[section.id];

                const sectionEl = document.createElement('section');
                sectionEl.className = `rounded-2xl bg-neon-card border transition-colors ${isSectionComplete ? 'border-neon-red shadow-neon-red/10' : 'border-neon-border'} overflow-hidden shadow-lg`;

                // Section Header with "Alle in dieser Sektion abhaken" action
                const headerHtml = `
                    <div class="w-full flex flex-wrap items-center justify-between gap-2 p-4 sm:p-5 bg-neutral-950/50 hover:bg-neon-cardHover transition select-none">
                        <div onclick="toggleSection('${section.id}')" class="flex items-center gap-3 sm:gap-4 pr-2 cursor-pointer flex-1 min-w-[220px]">
                            <span class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-xl font-black text-xs sm:text-sm shrink-0 transition-colors ${isSectionComplete ? 'bg-neon-red text-white shadow-md shadow-neon-red/40' : 'bg-neutral-900 text-neon-redBright border border-neon-red/40'}">
                                ${isSectionComplete ? '✓' : section.number}
                            </span>
                            <div>
                                <h2 class="text-base sm:text-lg font-extrabold text-white leading-snug">${section.title}</h2>
                                <div class="flex items-center gap-2.5 mt-1">
                                    <div class="w-24 sm:w-32 h-2 bg-neutral-900 rounded-full overflow-hidden border border-neutral-800">
                                        <div class="h-full bg-neon-red transition-all duration-300" style="width: ${Math.round((secChecked/secTotal)*100)}%"></div>
                                    </div>
                                    <span class="text-xs font-mono ${isSectionComplete ? 'text-neon-redBright font-bold' : 'text-neutral-300'}">${secChecked} / ${secTotal} abgehakt</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0 ml-auto">
                            <button onclick="toggleSectionItems('${section.id}', ${!isSectionComplete})" class="px-2.5 py-1.5 rounded-lg text-xs font-bold border transition flex items-center gap-1.5 ${isSectionComplete ? 'bg-neutral-900 text-neutral-300 border-neutral-700 hover:text-white' : 'bg-neon-red/15 hover:bg-neon-red text-neon-redBright hover:text-white border-neon-red/50'}">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span>${isSectionComplete ? 'Sektion öffnen' : 'Sektion abhaken'}</span>
                            </button>
                            <button onclick="toggleSection('${section.id}')" class="p-1.5 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-neon-red/50 text-neutral-300">
                                <svg class="w-5 h-5 transform transition-transform duration-200 ${isOpen ? 'rotate-180 text-neon-redBright' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                `;

                // Section Body
                let bodyHtml = '';
                if (isOpen) {
                    let groupsHtml = '';

                    if (section.infoBox) {
                        groupsHtml += `
                            <div class="mx-4 sm:mx-5 mb-4 p-3.5 rounded-xl bg-neutral-900/90 border-l-4 border-neon-red text-xs sm:text-sm text-neutral-200 leading-relaxed flex gap-3 items-start">
                                <svg class="w-5 h-5 text-neon-redBright shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>${section.infoBox}</span>
                            </div>
                        `;
                    }

                    section.groups.forEach(group => {
                        const visibleItems = group.items.filter(item => {
                            if (currentFilter === 'open') return !checkedState[item.id];
                            if (currentFilter === 'done') return !!checkedState[item.id];
                            return true;
                        });

                        if (visibleItems.length === 0) return;

                        let itemsListHtml = '';
                        visibleItems.forEach(item => {
                            const isChecked = !!checkedState[item.id];
                            
                            // Optional warning/stop/callout badges
                            let badgeHtml = '';
                            if (item.badge === 'GELB') {
                                badgeHtml = `<span class="inline-block px-2 py-0.5 text-[10px] font-black uppercase rounded bg-neon-red/20 text-white border border-neon-redBright mr-2 align-middle">GELB / WARNUNG</span>`;
                            } else if (item.badge === 'ROT') {
                                badgeHtml = `<span class="inline-block px-2 py-0.5 text-[10px] font-black uppercase rounded bg-neon-red text-white border border-white/40 mr-2 align-middle">ROT / STOPP</span>`;
                            } else if (item.badge === 'CALLOUT') {
                                badgeHtml = `<span class="inline-block px-2 py-0.5 text-[10px] font-black uppercase rounded bg-neon-red/25 text-neon-redBright border border-neon-red/50 mr-2 align-middle">WICHTIG</span>`;
                            }

                            itemsListHtml += `
                                <label onclick="toggleItem('${item.id}'); return false;" class="item-row group flex items-start gap-3.5 p-3.5 sm:px-4 rounded-xl cursor-pointer select-none transition-all border ${isChecked ? 'bg-neutral-950/90 border-neon-red/40' : 'bg-[#1a1a1a] hover:bg-[#222222] border-neutral-700 hover:border-neon-redBright'}">
                                    <input type="checkbox" ${isChecked ? 'checked' : ''} class="sr-only" aria-label="Punkt abhaken">
                                    <div class="checkbox-custom mt-0.5 w-7 h-7 rounded-lg flex items-center justify-center shrink-0 border-2 ${isChecked ? 'bg-neon-red border-neon-redBright text-white shadow-md shadow-neon-red/50' : 'border-neon-red/70 group-hover:border-neon-redBright bg-black'}">
                                        ${isChecked ? `
                                            <svg class="w-5 h-5 stroke-[3.5] text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                        ` : `
                                            <span class="w-2 h-2 rounded-sm bg-neutral-800 group-hover:bg-neon-red/50 transition"></span>
                                        `}
                                    </div>
                                    <div class="flex-1 text-sm sm:text-base leading-relaxed strike-anim ${isChecked ? 'line-through text-neutral-500' : 'text-white font-medium'}">
                                        ${badgeHtml}${item.text}
                                    </div>
                                    <span class="text-[11px] font-extrabold uppercase tracking-wider px-2 py-1 rounded self-center shrink-0 transition ${isChecked ? 'bg-neon-red/20 text-neon-redBright border border-neon-red/40' : 'bg-neutral-900 text-neutral-400 group-hover:text-white border border-neutral-800'}">
                                        ${isChecked ? '✓ Erledigt' : 'Abhaken'}
                                    </span>
                                </label>
                            `;
                        });

                        groupsHtml += `
                            <div class="px-4 sm:px-5 pb-4">
                                ${group.title ? `
                                    <h3 class="text-xs font-extrabold uppercase tracking-wider text-neon-redBright mb-2.5 mt-2 flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-neon-red"></span>
                                        ${group.title}
                                    </h3>
                                ` : ''}
                                <div class="space-y-2.5">
                                    ${itemsListHtml}
                                </div>
                            </div>
                        `;
                    });

                    if (groupsHtml === '') {
                        const emptyText = currentFilter === 'done'
                            ? 'Noch keine abgehakten Punkte in dieser Sektion.'
                            : 'Alle Punkte in dieser Sektion sind bereits abgehakt!';
                        groupsHtml = `
                            <div class="px-5 pb-5 text-xs text-neutral-400 italic">
                                ${emptyText}
                            </div>
                        `;
                    }

                    bodyHtml = `<div class="border-t border-neutral-800/80 pt-3">${groupsHtml}</div>`;
                }

                sectionEl.innerHTML = headerHtml + bodyHtml;
                container.appendChild(sectionEl);
            });

            // Update Top Progress Bar
            const percent = totalItems > 0 ? Math.round((totalChecked / totalItems) * 100) : 0;
            document.getElementById('progress-bar').style.width = `${percent}%`;
            document.getElementById('progress-percent').textContent = `${percent}%`;
            document.getElementById('progress-count').textContent = `(${totalChecked} / ${totalItems} Punkte abgehakt)`;
        }

        // Toggle single item
        function toggleItem(itemId) {
            checkedState[itemId] = !checkedState[itemId];
            saveState();
            renderChecklist();
        }

        // Check or uncheck all items within a single section
        function toggleSectionItems(secId, checkStatus) {
            const section = checklistData.find(s => s.id === secId);
            if (!section) return;
            section.groups.forEach(g => {
                g.items.forEach(item => {
                    checkedState[item.id] = checkStatus;
                });
            });
            saveState();
            renderChecklist();
        }

        // Toggle single section accordion
        function toggleSection(secId) {
            openSections[secId] = !openSections[secId];
            renderChecklist();
        }

        // Expand or collapse all sections
        function toggleAllSections(expand) {
            checklistData.forEach(sec => {
                openSections[sec.id] = expand;
            });
            renderChecklist();
        }

        // Filter ('all', 'open', 'done')
        function setFilter(filterType) {
            currentFilter = filterType;
            const filters = ['all', 'open', 'done'];
            filters.forEach(type => {
                const btn = document.getElementById(`filter-${type}`);
                if (!btn) return;
                if (type === filterType) {
                    btn.className = 'px-3 py-1.5 rounded-md text-xs font-bold transition bg-neon-red text-white shadow';
                } else {
                    btn.className = 'px-3 py-1.5 rounded-md text-xs font-bold transition text-neutral-400 hover:text-white';
                }
            });
            renderChecklist();
        }

        // Modal Functions
        function openResetModal() {
            const modal = document.getElementById('reset-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeResetModal() {
            const modal = document.getElementById('reset-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function resetAllItems() {
            checkedState = {};
            saveState();
            closeResetModal();
            renderChecklist();
        }

        function checkAllItems() {
            checklistData.forEach(sec => {
                sec.groups.forEach(g => {
                    g.items.forEach(item => {
                        checkedState[item.id] = true;
                    });
                });
            });
            saveState();
            closeResetModal();
            renderChecklist();
        }

        // 20-Minute Briefing Timer
        let timerSeconds = 20 * 60;
        let timerInterval = null;
        let isTimerRunning = false;

        function updateTimerDisplay() {
            const mins = Math.floor(timerSeconds / 60);
            const secs = timerSeconds % 60;
            const display = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            const timerEl = document.getElementById('timer-display');
            const timerBox = document.getElementById('timer-box');
            timerEl.textContent = display;

            if (timerSeconds <= 180 && timerSeconds > 0) {
                timerEl.classList.add('text-neon-redBright');
                timerBox.classList.add('border-neon-red');
            } else if (timerSeconds === 0) {
                timerEl.classList.add('text-neon-redBright');
                timerBox.classList.add('timer-warning', 'border-neon-redBright');
            } else {
                timerEl.classList.remove('text-neon-redBright');
                timerBox.classList.remove('timer-warning', 'border-neon-red', 'border-neon-redBright');
            }
        }

        function toggleTimer() {
            const playIcon = document.getElementById('timer-play-icon');
            const pauseIcon = document.getElementById('timer-pause-icon');

            if (isTimerRunning) {
                clearInterval(timerInterval);
                isTimerRunning = false;
                playIcon.classList.remove('hidden');
                pauseIcon.classList.add('hidden');
            } else {
                if (timerSeconds <= 0) timerSeconds = 20 * 60;
                isTimerRunning = true;
                playIcon.classList.add('hidden');
                pauseIcon.classList.remove('hidden');
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        updateTimerDisplay();
                    } else {
                        clearInterval(timerInterval);
                        isTimerRunning = false;
                        playIcon.classList.remove('hidden');
                        pauseIcon.classList.add('hidden');
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            timerSeconds = 20 * 60;
            document.getElementById('timer-play-icon').classList.remove('hidden');
            document.getElementById('timer-pause-icon').classList.add('hidden');
            updateTimerDisplay();
        }

        // Fullscreen API Toggle
        function toggleFullScreen() {
            const docEl = document.documentElement;
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                if (docEl.requestFullscreen) {
                    docEl.requestFullscreen().catch(() => {});
                } else if (docEl.webkitRequestFullscreen) {
                    docEl.webkitRequestFullscreen();
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().catch(() => {});
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                }
            }
        }

        document.addEventListener('fullscreenchange', updateFullscreenButton);
        document.addEventListener('webkitfullscreenchange', updateFullscreenButton);

        function updateFullscreenButton() {
            const isFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
            document.getElementById('fs-enter-icon').classList.toggle('hidden', isFs);
            document.getElementById('fs-exit-icon').classList.toggle('hidden', !isFs);
            document.getElementById('fs-text').textContent = isFs ? 'Vollbild beenden' : 'Vollbildmodus';
        }

        // Initialize on page load
        window.onload = function() {
            loadState();
            renderChecklist();
            updateTimerDisplay();
        };
    </script>
</body>
</html>
